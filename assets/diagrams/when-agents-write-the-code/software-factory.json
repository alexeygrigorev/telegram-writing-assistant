{
  "title": "A software factory with review",
  "description": "A backlog feeds an implementer agent. A reviewer returns rejected changes for revision, while accepted changes become the product.",
  "canvas": {
    "width": 1080,
    "height": 360,
    "background": "#ffffff"
  },
  "layout": {
    "type": "manual",
    "card_width": 260,
    "card_height": 100
