      "icon": "queue",
      "color": "gray",
      "x": 40,
      "y": 40
    },
    {
      "id": "maker",
      "title": "Implementer agent",
      "icon": "robot",
      "color": "amber",
      "x": 40,
      "y": 220
    },
    {
      "id": "checker",
      "title": "Reviewer agent",
      "icon": "search",
      "color": "purple",
      "x": 540,
      "y": 220
    },
    {
      "id": "product",
      "title": "Product",
      "variant": "icon",
      "icon": "browser",
      "color": "green",
      "x": 900,
      "y": 220,
      "width": 140,
      "height": 100
