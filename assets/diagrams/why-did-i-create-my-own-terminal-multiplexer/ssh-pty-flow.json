{
  "title": "SSH opens a PTY on the remote machine",
  "description": "The SSH connection crosses from your computer to sshd on the remote devbox. There, sshd opens a separate PTY for Bash.",
  "canvas": {"width": 1180, "height": 400, "background": "#ffffff"},
  "layout": {"type": "manual", "card_width": 190, "card_height": 100},
  "nodes": [
