    {"id": "remote-machine", "title": "REMOTE DEVBOX", "variant": "boundary", "color": "green", "x": 250, "y": 40, "width": 900, "height": 320},
    {"id": "ssh-client", "title": "SSH client", "variant": "icon", "icon": "terminal", "color": "blue", "x": 85, "y": 172, "width": 56, "height": 56},
    {"id": "sshd", "title": "sshd", "subtitle": "accepts the connection", "icon": "settings", "color": "green", "x": 300, "y": 150},
    {"id": "remote-pty", "title": "Remote PTY", "subtitle": "master side ↔ slave side", "color": "purple", "x": 590, "y": 140, "width": 240, "height": 120},
