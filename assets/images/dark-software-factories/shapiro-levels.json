{
  "title": "Dan Shapiro's five levels of AI-assisted coding",
  "description": "Six stages from level 0 to level 5 descend toward greater agent autonomy and less routine human code review.",
  "style": "asl-light",
  "canvas": {
    "width": 1200,
    "height": 815
  },
  "layout": {
    "type": "staircase",
    "direction": "descending",
    "card_width": 320,
    "card_height": 105
  },
  "nodes": [
    {
      "id": "l0",
      "title": "Level 0 · Write code",
      "subtitle": "AI suggests occasionally",
      "color": "gray",
      "icon": "terminal"
    },
    {
      "id": "l1",
      "title": "Level 1 · Delegate",
      "subtitle": "Small tasks",
      "color": "blue",
      "icon": "issue"
    },
    {
      "id": "l2",
      "title": "Level 2 · Pair",
      "subtitle": "Stay in implementation",
      "color": "blue",
      "icon": "user"
    },
    {
      "id": "l3",
      "title": "Level 3 · Review",
      "subtitle": "Read agent-written code",
      "color": "purple",
      "icon": "search"
    },
    {
      "id": "l4",
      "title": "Level 4 · Specify",
      "subtitle": "Set checks; agents work",
